---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';

const title = 'Thanks — we got your message';
const description = 'Your message has been sent to Bullseye Pest Management. Steve will get back to you personally.';
---

<BaseLayout title={title} description={description} canonicalPath="/thank-you/" noindex={true}>
  <section class="max-w-container mx-auto px-4 py-20 text-center">
    <div class="max-w-2xl mx-auto">
      <div class="w-20 h-20 bg-brand-green rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-white" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 1.414-1.414L8 12.586l7.293-7.293a1 1 0 0 1 1.414 0z" clip-rule="evenodd"/>
        </svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-display font-extrabold text-ink">
        Thanks — we got your message.
      </h1>
      <p class="mt-4 text-lg text-ink-soft">
        Steve will reply personally, typically within one business hour during hours ({business.hours.short}). If you sent this after hours, expect a reply next business morning.
      </p>
      <p class="mt-3 text-ink-soft">
        Need to talk now? Call <a href={`tel:${business.phone.primaryTel}`} class="text-brand-red font-semibold underline">{business.phone.primary}</a>.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="inline-flex items-center justify-center gap-2 bg-brand-red hover:bg-brand-red-dark text-white font-semibold px-6 py-3 rounded-md min-h-[48px]">
          Back to Home
        </a>
        <a href="/blog/" class="inline-flex items-center justify-center gap-2 border-2 border-brand-red text-brand-red hover:bg-brand-red hover:text-white font-semibold px-6 py-3 rounded-md min-h-[48px]">
          Read the Blog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
