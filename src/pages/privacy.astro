---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
---

<BaseLayout title="Privacy Policy | Bullseye Pest Management" description="Privacy policy for Bullseye Pest Management." canonicalPath="/privacy/">
  <Breadcrumbs crumbs={[{ label: 'Privacy Policy', href: '/privacy/' }]} />
  <section class="max-w-container mx-auto px-4 py-10">
    <div class="max-w-3xl mx-auto prose-content">
      <h1 class="text-3xl sm:text-4xl font-display font-extrabold text-ink">Privacy Policy</h1>
      <p><strong>Last updated:</strong> July 3, 2026</p>
      <p>Bullseye Pest Management, LLC ("we", "us", "our") respects your privacy. This policy explains what information we collect through this website and how we use it.</p>
      <h2>What We Collect</h2>
      <p>When you submit our contact form or call us, we may collect: your name, phone number, email address, city, and description of your service request. We collect only what you provide.</p>
      <h2>How We Use It</h2>
      <p>We use your information to respond to your service request, provide quotes, schedule work, and follow up. We do not sell or share your information with third parties for their marketing purposes.</p>
      <h2>Analytics</h2>
      <p>We may use privacy-respecting analytics tools (such as Google Analytics or similar) to understand how visitors use our site. These tools may set cookies. You can disable cookies in your browser settings.</p>
      <h2>Contact</h2>
      <p>Questions about this policy? Contact us at <a href={`mailto:${business.email}`}>{business.email}</a> or {business.phone.primary}.</p>
    </div>
  </section>
</BaseLayout>
