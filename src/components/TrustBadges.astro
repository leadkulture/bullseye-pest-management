---
import { business } from '../data/business';

interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
const bg = variant === 'dark' ? 'bg-ink' : 'bg-surface-soft';
const textColor = variant === 'dark' ? 'text-white' : 'text-ink';
const subColor = variant === 'dark' ? 'text-gray-300' : 'text-ink-muted';
---

<section class={bg}>
  <div class="max-w-container mx-auto px-4 py-10 sm:py-12">
    <div class="text-center mb-8">
      <p class={`text-sm font-semibold uppercase tracking-wide ${subColor}`}>Certified &amp; Trusted</p>
      <h2 class={`mt-1 text-2xl font-display font-bold ${textColor}`}>
        Credentials that back the work
      </h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 items-center">
      {business.certifications.map(c => (
        <div class="flex flex-col items-center text-center">
          <img
            src={c.image}
            alt={c.name}
            width="120"
            height="120"
            loading="lazy"
            class="h-20 sm:h-24 w-auto object-contain"
          />
          <p class={`mt-3 text-xs sm:text-sm font-medium ${textColor}`}>{c.short}</p>
        </div>
      ))}
    </div>
    <p class={`mt-6 text-center text-xs ${subColor}`}>
      License {business.license} &middot; Serving DFW since {business.foundedYear}
    </p>
  </div>
</section>
