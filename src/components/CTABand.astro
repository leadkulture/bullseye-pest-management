---
import { business } from '../data/business';

interface Props {
  headline?: string;
  sub?: string;
  variant?: 'red' | 'green' | 'dark';
}

const {
  headline = 'Ready to solve your pest problem?',
  sub = `Call ${business.phone.primary} for a free inspection. Certified applicator, no contracts, honest pricing.`,
  variant = 'red',
} = Astro.props;

const bg = variant === 'green' ? 'bg-brand-green' : variant === 'dark' ? 'bg-ink' : 'bg-brand-red';
---

<section class={`${bg} text-white`}>
  <div class="max-w-container mx-auto px-4 py-10 sm:py-14 grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-6">
    <div>
      <h2 class="text-2xl sm:text-3xl font-display font-bold mb-2">{headline}</h2>
      <p class="text-white/90">{sub}</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href={`tel:${business.phone.primaryTel}`} class="inline-flex items-center justify-center gap-2 bg-white text-brand-red font-semibold px-6 py-3 rounded-md hover:bg-gray-100 min-h-[48px]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2A1.5 1.5 0 0 1 7 3.5v2A1.5 1.5 0 0 1 5.5 7h-.379a11.5 11.5 0 0 0 7.879 7.879V14.5A1.5 1.5 0 0 1 14.5 13h2A1.5 1.5 0 0 1 18 14.5v2A1.5 1.5 0 0 1 16.5 18h-1C7.492 18 2 12.508 2 4.5v-1z"/>
        </svg>
        Call {business.phone.primary}
      </a>
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-white/10 border-2 border-white text-white font-semibold px-6 py-3 rounded-md hover:bg-white/20 min-h-[48px]">
        Free Quote
      </a>
    </div>
  </div>
</section>
