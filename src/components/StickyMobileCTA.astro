---
import { business } from '../data/business';
---

<!-- Fixed bottom CTA bar, mobile only. Primary conversion path for local search. -->
<div class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-white border-t border-gray-200 shadow-lg">
  <div class="grid grid-cols-2 gap-0">
    <a
      href={`tel:${business.phone.primaryTel}`}
      class="flex items-center justify-center gap-2 bg-brand-red text-white font-semibold py-3.5 min-h-[52px]"
      aria-label={`Call ${business.displayName}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2A1.5 1.5 0 0 1 7 3.5v2A1.5 1.5 0 0 1 5.5 7h-.379a11.5 11.5 0 0 0 7.879 7.879V14.5A1.5 1.5 0 0 1 14.5 13h2A1.5 1.5 0 0 1 18 14.5v2A1.5 1.5 0 0 1 16.5 18h-1C7.492 18 2 12.508 2 4.5v-1z"/>
      </svg>
      Call Now
    </a>
    <a
      href="/contact/"
      class="flex items-center justify-center gap-2 bg-brand-green text-white font-semibold py-3.5 min-h-[52px]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M2.003 5.884 10 9.882l7.997-3.998A2 2 0 0 0 16 4H4a2 2 0 0 0-1.997 1.884z"/>
        <path d="m18 8.118-8 4-8-4V14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8.118z"/>
      </svg>
      Free Quote
    </a>
  </div>
</div>
<!-- Spacer to prevent content being hidden under fixed bar on mobile -->
<div class="h-14 md:hidden" aria-hidden="true"></div>
