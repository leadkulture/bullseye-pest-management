---
import { business } from '../data/business';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

const items = [{ label: 'Home', href: '/' }, ...crumbs];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: `${business.urls.canonical}${c.href}` } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="max-w-container mx-auto px-4 pt-4">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink-muted">
    {items.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {c.href && i < items.length - 1 ? (
          <a href={c.href} class="hover:text-brand-red hover:underline">{c.label}</a>
        ) : (
          <span class="text-ink-soft" aria-current="page">{c.label}</span>
        )}
        {i < items.length - 1 && (
          <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 0 1 0-1.414L10.586 10 7.293 6.707a1 1 0 1 1 1.414-1.414l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414 0z" clip-rule="evenodd"/>
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
