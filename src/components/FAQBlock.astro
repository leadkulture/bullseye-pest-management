---
interface Props {
  title?: string;
  faqs: { q: string; a: string }[];
  emitSchema?: boolean;
}

const { title = 'Frequently Asked Questions', faqs, emitSchema = true } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="max-w-container mx-auto px-4 py-12 sm:py-16">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink mb-6">{title}</h2>
    <div class="divide-y divide-gray-200">
      {faqs.map((f, i) => (
        <details class="group py-4" open={i === 0}>
          <summary class="flex items-center justify-between gap-3 cursor-pointer list-none min-h-[44px]">
            <h3 class="text-base sm:text-lg font-semibold text-ink group-hover:text-brand-red transition-colors">{f.q}</h3>
            <svg class="w-5 h-5 flex-shrink-0 text-ink-muted transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 0 1 1.08 1.04l-4.25 4.4a.75.75 0 0 1-1.08 0l-4.25-4.4a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd"/>
            </svg>
          </summary>
          <p class="mt-3 text-ink-soft leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

{emitSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
