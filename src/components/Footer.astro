---
import { business, primaryCTA } from '../data/business';
import { services } from '../data/services';
import { serviceAreas } from '../data/service-areas';
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div class="max-w-container mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    <!-- Brand + NAP -->
    <div>
      <img
        src="/images/logo.png"
        alt={`${business.displayName} logo`}
        width="220"
        height="86"
        class="h-14 w-auto bg-white rounded p-1 mb-4"
        loading="lazy"
      />
      <p class="text-sm text-gray-300 mb-2">{business.tagline} &middot; License {business.license}</p>
      <p class="text-sm text-gray-300">
        Serving the {business.address.region} since {business.foundedYear}.
      </p>
      <div class="mt-4 space-y-1 text-sm">
        <p><a href={primaryCTA.href} class="text-white font-semibold hover:text-brand-red-light">Local: {business.phone.local}</a></p>
        <p><a href={`tel:${business.phone.tollFreeTel}`} class="text-white font-semibold hover:text-brand-red-light">Toll Free: {business.phone.tollFree}</a></p>
        <p><a href={`mailto:${business.email}`} class="text-gray-300 hover:text-white">{business.email}</a></p>
        <p class="text-gray-300">{business.hours.display}</p>
      </div>
    </div>

    <!-- Services -->
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-red-light mb-4">Services</h3>
      <ul class="space-y-2 text-sm">
        {services.map(s => (
          <li><a href={`/services/${s.slug}/`} class="text-gray-300 hover:text-white">{s.navTitle}</a></li>
        ))}
      </ul>
    </div>

    <!-- Service Areas -->
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-red-light mb-4">Service Areas</h3>
      <ul class="space-y-2 text-sm">
        {serviceAreas.map(a => (
          <li><a href={`/service-areas/${a.slug}/`} class="text-gray-300 hover:text-white">{a.city}, {a.state}</a></li>
        ))}
        <li><a href="/service-areas/" class="text-brand-red-light hover:text-white font-medium">See all service areas &rarr;</a></li>
      </ul>
    </div>

    <!-- Company -->
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-red-light mb-4">Company</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/about/" class="text-gray-300 hover:text-white">About Steve</a></li>
        <li><a href="/contact/" class="text-gray-300 hover:text-white">Contact / Free Quote</a></li>
        <li><a href="/blog/" class="text-gray-300 hover:text-white">Blog</a></li>
        <li><a href={business.urls.facebook} rel="noopener" target="_blank" class="text-gray-300 hover:text-white">Facebook</a></li>
        <li><a href={business.urls.google} rel="noopener" target="_blank" class="text-gray-300 hover:text-white">Google Business Profile</a></li>
      </ul>

      <div class="mt-6 flex flex-wrap gap-2">
        {business.certifications.map(c => (
          <img
            src={c.image}
            alt={c.name}
            width="48"
            height="48"
            loading="lazy"
            class="h-12 w-12 object-contain bg-white rounded p-1"
          />
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-container mx-auto px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-400">
      <p>&copy; {year} {business.legalName}. All rights reserved. License {business.license}.</p>
      <div class="flex gap-4">
        <a href="/terms/" class="hover:text-white">Terms of Use</a>
        <a href="/privacy/" class="hover:text-white">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
